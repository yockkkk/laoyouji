# ===== 大模型 =====
LLM_PROVIDER=mock                 # deepseek | mock（无 key 开发/离线演示）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 语音识别（方言）=====
ASR_PROVIDER=tencent              # tencent | iflytek | mock（缺 key 自动退化 mock）
# 腾讯云一句话识别（官方 SDK；凭据为 CAM 的 SecretId/SecretKey，SecretKey 仅新建时完整显示）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
# 讯飞语音听写三件套（ASR_PROVIDER=iflytek 时用）
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=

# ===== 存储 =====
STORAGE_BACKEND=local             # supabase | local（JSON 文件，断网兜底）
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
LOCAL_DATA_DIR=./local_data

# ===== 安全管控 =====
RISK_AMOUNT_THRESHOLD=50          # 金额超过该值即触发子女确认（元）
CONFIRM_TIMEOUT_MIN=30            # 确认任务超时（分钟）
